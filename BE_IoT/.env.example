# CẤU HÌNH MÁY CHỦ BACKEND
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# CƠ SỞ DỮ LIỆU MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_home_db
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_CONNECTION_LIMIT=10

# BẢO MẬT & JWT AUTHENTICATION
JWT_SECRET=replace_with_a_long_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=24h

# MQTT BROKER (Mosquitto)
# Cấu hình URL đầy đủ bao gồm giao thức, host và port thực tế
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=iot_backend_service
MQTT_USERNAME=
MQTT_PASSWORD=

# TOPICS MQTT (Khớp với firmware ESP32)
MQTT_TOPIC_DEVICE=device
MQTT_TOPIC_DEVICE_STATUS=device/status
MQTT_TOPIC_SENSOR=sensor
MQTT_TOPIC_SENSOR_DATA=sensor/data
MQTT_TOPIC_ESP32_STATUS=esp32/status

# THỜI GIAN CHỜ & NGƯỠNG ĐỒNG BỘ (MILI-GIÂY)
SENSOR_STALE_MS=15000
MQTT_COMMAND_TIMEOUT_MS=5000
